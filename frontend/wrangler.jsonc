{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "consman",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  },
  "routes": [
    {
      "pattern": "consman.rauniyaraman.com.np",
      "custom_domain": true
    }
  ]
}
