{
  "name": "consman-render-keepalive",
  "main": "worker.mjs",
  "compatibility_date": "2026-10-02",
  "workers_dev": false,
  "triggers": {"crons": ["*/10 * * * *"]},
  "observability": {"enabled": true},
  "vars": {
    "ENABLED": "true",
    "CONSMAN_HEALTH_URL": "https://consman-rauniyaraman-api.onrender.com/api/v1/health/",
    "GATEWAY_HEALTH_URL": "https://consman-whatsapp-gateway.onrender.com/api/health"
  }
}
