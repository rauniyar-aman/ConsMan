DJANGO_DEBUG=true
DJANGO_SECRET_KEY=replace-for-deployment
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Omit DATABASE_URL for local SQLite, or use PostgreSQL:
# DATABASE_URL=postgresql://consman:password@localhost:5432/consman
# Export these variables in your shell; .env is not loaded automatically.

# WhatsApp Gateway (WA-AKG). Run Gateway on a different port from ConsMan.
WHATSAPP_GATEWAY_URL=http://127.0.0.1:3001
WHATSAPP_GATEWAY_KEY=
WHATSAPP_GATEWAY_SESSION=
WHATSAPP_GATEWAY_WEBHOOK_SECRET=

# Production public registration and bot protection
PUBLIC_FORM_ORIGIN=http://127.0.0.1:3000
PUBLIC_ALLOWED_ORIGINS=http://127.0.0.1:3000,http://localhost:3000
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
TURNSTILE_HOSTNAME=
INTAKE_DEV_BYPASS=true
OTP_ALLOWED_COUNTRY_PREFIXES=+977
PUBLIC_SUBMISSIONS_PER_DAY=40
# Replace with actual trusted reverse-proxy ranges in deployment.
TRUSTED_PROXY_IPS=127.0.0.1/32,::1/128

# Optional SMS adapter; confirm your chosen provider's contract before enabling.
SMS_PROVIDER_URL=
SMS_PROVIDER_KEY=
SMS_MESSAGE_COST_MINOR=1
WHATSAPP_MESSAGE_COST_MINOR=0

# Private encrypted object storage (credentials should use the host's managed role).
# S3_BUCKET=your-private-bucket
# AWS_REGION=ap-south-1
# S3_ENDPOINT_URL=
# BACKUP_ENCRYPTION_KEY=<securely retained Fernet key for local backup command>
